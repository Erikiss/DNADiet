# --- Rohe DNA-Dateien aus dem Git heraushalten (GROESSE, nicht Datenschutz) ---
# Whole-Genome-VCF/CRAM sind oft mehrere GB und ueberschreiten GitHubs 100-MB-Limit.
# Wer die Rohdaten oeffentlich teilen will, nutzt dafuer Release-Assets / Git LFS /
# externes Hosting. Das kleine genome/profile.json wird ganz normal committet.
*.vcf
*.vcf.gz
*.hc.gz
*.g.vcf.gz
*.gvcf.gz
*.cram
*.crai
*.bam
*.bai
*.tbi
*.csi
*.fa
*.fasta
*.fai

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# --- Diverses ---
.ipynb_checkpoints/
.DS_Store
